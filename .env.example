# Copy to .env and fill in. Never commit .env.

# SimpleFIN: paste the setup token, then run `python3 scripts/sync_bank.py --claim`
# to exchange it for the access URL (written back here as SIMPLEFIN_TOKEN).
SIMPLEFIN_SETUP_TOKEN=
SIMPLEFIN_TOKEN=

# iCloud CalDAV (use an app-specific password from appleid.apple.com)
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
# Comma-separated calendar display names to sync, e.g. Personal,Work
CALENDARS_TO_SYNC=

# Discord webhook for pipeline success/error/reminder embeds (blank = disabled)
DISCORD_WEBHOOK_URL=

# Anthropic API key for the daily insight generator
ANTHROPIC_API_KEY=
INSIGHT_MODEL=claude-opus-4-7
LOCAL_TIMEZONE=America/Los_Angeles
