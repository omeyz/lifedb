    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/generate_insight.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/generate_insight_error.log</string>
</dict>
</plist>
